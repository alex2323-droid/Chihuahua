rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(sellerId) {
      return isSignedIn() && (request.auth.uid == sellerId || request.auth.token.email == sellerId + "@catalogcraft.internal");
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Sellers root collection
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == sellerId;

      // Store settings subcollection
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == sellerId;
      }

      // Catalogs subcollection
      match /catalogs/{catalogId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == sellerId;

        // Chunks subcollection for large high-resolution product images
        match /chunks/{chunkId} {
          allow read: if true;
          allow write: if isSignedIn() && request.auth.uid == sellerId;
        }
      }
    }

    // Customers collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == customerId;
    }

    // Diagnostic error logs for remote troubleshooting
    match /error_logs/{logId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
