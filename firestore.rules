rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(sellerId) {
      return isSignedIn() && (request.auth.uid == sellerId || request.auth.token.email == sellerId + "@catalogcraft.internal");
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Sellers root collection
    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if isSignedIn();

      // Store settings subcollection
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Catalogs subcollection
      match /catalogs/{catalogId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}
