{
  "entities": {
    "Seller": {
      "title": "Seller Account",
      "description": "Seller profile details",
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "sellerId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "sellerId"
      ]
    },
    "StoreSettings": {
      "title": "Store Settings",
      "description": "Custom store branding, layout and contact details",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string"
        },
        "storeTagline": {
          "type": "string"
        },
        "storeLogo": {
          "type": "string"
        },
        "coverImage": {
          "type": "string"
        },
        "whatsappNumber": {
          "type": "string"
        },
        "instagramHandle": {
          "type": "string"
        },
        "currencySymbol": {
          "type": "string"
        },
        "themeColor": {
          "type": "string"
        },
        "catalogLayout": {
          "type": "string"
        }
      },
      "required": [
        "storeName"
      ]
    },
    "Catalog": {
      "title": "Product Catalog",
      "description": "Catalog containing products for a seller",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "isChunked": {
          "type": "boolean"
        },
        "chunkCount": {
          "type": "integer"
        },
        "products": {
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "CatalogChunk": {
      "title": "Catalog Chunk",
      "description": "Partitioned product document allowing unlimited high-resolution images beyond the 1MB single-document limit",
      "type": "object",
      "properties": {
        "chunkIndex": {
          "type": "integer"
        },
        "products": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "chunkIndex",
        "products"
      ]
    },
    "Customer": {
      "title": "Customer Profile",
      "description": "Customer account details and delivery address details",
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "customerId": {
          "type": "string"
        },
        "whatsapp": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": [
        "username",
        "customerId"
      ]
    },
    "DiagnosticLog": {
      "title": "Diagnostic Error Log",
      "description": "Critical client errors and load diagnostics saved to Firestore for remote debugging",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "operationType": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sellerId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userAgent": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "error",
        "timestamp"
      ]
    }
  },
  "firestore": {
    "/sellers/{sellerId}": {
      "schema": "Seller",
      "description": "Sellers account document"
    },
    "/sellers/{sellerId}/settings/current": {
      "schema": "StoreSettings",
      "description": "Seller store configuration"
    },
    "/sellers/{sellerId}/catalogs/{catalogId}": {
      "schema": "Catalog",
      "description": "Seller product catalogs"
    },
    "/sellers/{sellerId}/catalogs/{catalogId}/chunks/{chunkId}": {
      "schema": "CatalogChunk",
      "description": "Sub-documents containing product partitions for high resolution image storage"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profile and delivery details"
    },
    "/error_logs/{logId}": {
      "schema": "DiagnosticLog",
      "description": "Diagnostic error logs for remote troubleshooting"
    }
  }
}
